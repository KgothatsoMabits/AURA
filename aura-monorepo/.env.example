NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=false # set true for managed databases whose URL omits sslmode
JWT_SECRET=replace-with-at-least-32-random-characters
ID_ENC_KEY=replace-with-32-random-characters # generate with: openssl rand -hex 32
ID_HASH_PEPPER=replace-with-at-least-16-random-characters
OTP_PEPPER=replace-with-at-least-16-random-characters
ALLOWED_ORIGINS=http://localhost:3000,https://localhost,capacitor://localhost
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
NOTIFY_CONTACTS_ON_CREATE=false
RETENTION_DAYS_LOCATIONS=90

# Community Guardian nearby alerts (disabled by default)
GUARDIAN_ALERTS_ENABLED=false
GUARDIAN_DEFAULT_RADIUS_M=1000
GUARDIAN_PRESENCE_TTL_MIN=30
GUARDIAN_MAX_RECIPIENTS=25
GUARDIAN_MAX_ALERTS_PER_HOUR=3
VICTIM_MAX_NEARBY_PER_HOUR=2
GUARDIAN_GRID_M=250
PUSH_PROVIDER=console
# Required only with PUSH_PROVIDER=fcm; base64-encoded Firebase service-account JSON
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_B64=
# Optional judge demo access (disabled by default). Keep these only in the API environment.
DEMO_AUTH_ENABLED=false
DEMO_ACCESS_KEY=replace-with-a-random-secret-at-least-24-characters-long
# Comma-separated exact E.164 phones of provisioned demo accounts; no spaces required.
DEMO_ACCOUNT_PHONES=+27820000001,+27820000002,+27820000003
# Only needed when intentionally seeding demo users in a production judging environment.
DEMO_SEED_ENABLED=false
DEMO_SEED_CONFIRM=
